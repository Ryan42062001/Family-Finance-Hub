{
  "name": "family-finance-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test \"lib/calculations/*.test.ts\"",
    "test:security": "node --experimental-strip-types --test tests/security/*.test.ts",
    "typecheck": "tsc --noEmit",
    "ai:validate-state": "node scripts/validate-ai-state.mjs",
    "verify": "npm run ai:validate-state && npm test && npm run test:security && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.3",
    "typescript": "^5.9.0"
  }
}